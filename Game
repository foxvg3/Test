# --- КЭШ ТЕКСТУР С ТРЕЩИНАМИ ---
_CRACKED_TEXTURES = {}

def get_cracked_texture(block_type):
    if block_type in _CRACKED_TEXTURES:
        return _CRACKED_TEXTURES[block_type]
    base = TEXTURES.get(block_type)
    if not base:
        return None
    surf = base.copy()
    draw_cracks(surf)
    _CRACKED_TEXTURES[block_type] = surf
    return surf

def draw_cracks(surface):
    pygame.draw.line(surface, (40, 40, 40), (4, 4), (36, 36), 2)
    pygame.draw.line(surface, (40, 40, 40), (36, 4), (4, 36), 2)
    pygame.draw.line(surface, (40, 40, 40), (20, 4), (20, 36), 1)
    pygame.draw.line(surface, (40, 40, 40), (4, 20), (36, 20), 1)

