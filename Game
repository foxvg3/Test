    def try_place_block(self, screen_x, screen_y):
        world_x = screen_x + self.camera_x
        world_y = screen_y + self.camera_y
        col = int(world_x // TILE_SIZE)
        row = int(world_y // TILE_SIZE)
        if row < 0 or row >= WORLD_HEIGHT - 1:
            return False
        current_block = self.world.get_block(row, col)
        slot = self.player.hotbar[self.player.active_hotbar_index]
        if current_block == LADDER and slot["item"] == "Лестница" and slot["count"] > 0:
            below_block = self.world.get_block(row + 1, col)
            if below_block == AIR:
                dist = math.hypot(world_x - self.player.rect.centerx,
                                  world_y - self.player.rect.centery)
                if dist < TILE_SIZE * 5:
                    self.world.set_block(row + 1, col, LADDER)
                    slot["count"] -= 1
                    if slot["count"] <= 0:
                        slot["item"] = None
                        slot["count"] = 0
                    return True
            return False
        if current_block != AIR:
            return False
        if self.player.rect.colliderect(pygame.Rect(col * TILE_SIZE, row * TILE_SIZE, TILE_SIZE, TILE_SIZE)):
            return False
        block_map = {
            "Земля": DIRT, "Камень": STONE, "Дерево": WOOD, "Лестница": LADDER,
            "Медь": COPPER_ORE, "Серебро": SILVER_ORE, "Топаз": TOPAZ_ORE,
            "Сапфир": SAPPHIRE_ORE, "Обсидиан": OBSIDIAN_ORE, "Факел": TORCH,
            "Тём.Камень": DARK_STONE, "Крас.Камень": RED_STONE,
            "Кристаллит": CRYSTALLITE_ORE, "Тенерит": TENEBRITE_ORE,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
        }
        if slot["item"] in block_map and slot["count"] > 0:
            dist = math.hypot(world_x - self.player.rect.centerx,
                              world_y - self.player.rect.centery)
            if dist < TILE_SIZE * 5:
                self.world.set_block(row, col, block_map[slot["item"]])
                slot["count"] -= 1
                if slot["count"] <= 0:
                    slot["item"] = None
                    slot["count"] = 0
                return True
        return False

    def dig_block(self, screen_x, screen_y):
        world_x = screen_x + self.camera_x
        world_y = screen_y + self.camera_y
        col = int(world_x // TILE_SIZE)
        row = int(world_y // TILE_SIZE)
        if row < 0 or row >= WORLD_HEIGHT - 1:
            return
        tool = self.player.get_current_tool()
        if tool is None or tool not in PICKAXE_DATA:
            return
        block = self.world.get_block(row, col)
        if block == AIR:
            return
        dist = math.hypot(world_x - self.player.rect.centerx,
                          world_y - self.player.rect.centery)
        if dist >= TILE_SIZE * 5:
            return
        pk = PICKAXE_DATA[tool]
        self.player.dig_anim_time = 1.0
        if block == LEAVES:
            self.world.set_block(row, col, AIR)
            self.spawn_particles(world_x, world_y, LEAVES)
            return
        block_tier = ORE_TIERS.get(block, 0)
        if pk["tier"] < block_tier:
            return
        if block in pk["multi_hit"]:
            self.apply_hit_block(row, col, pk["multi_hit"][block], block)
            return
        area_w, area_h = pk["area"]
        for dy in range(area_h):
            for dx in range(area_w):
                tr, tc = row + dy, col + dx
                tb = self.world.get_block(tr, tc)
                if tb != AIR and tb != LADDER and tb != TORCH:
                    if tb in pk["multi_hit"]:
                        continue
                    tb_tier = ORE_TIERS.get(tb, 0)
                    if pk["tier"] < tb_tier:
                        continue
                    self.spawn_dropped_item(tr, tc, tb)
                    self.spawn_particles(tc * TILE_SIZE + TILE_SIZE // 2,
                                         tr * TILE_SIZE + TILE_SIZE // 2, tb)

    def spawn_dropped_item(self, row, col, block_type):
        names = {
            DIRT: "Земля", GRASS: "Земля", STONE: "Камень", WOOD: "Дерево",
            COAL: "Уголь", IRON_ORE: "Железо", DIAMOND_ORE: "Алмаз",
            AMETHYST_ORE: "Аметист", EMERALD_ORE: "Изумруд", RUBY_ORE: "Рубин",
            LADDER: "Лестница", COPPER_ORE: "Медь", SILVER_ORE: "Серебро",
            TOPAZ_ORE: "Топаз", SAPPHIRE_ORE: "Сапфир", OBSIDIAN_ORE: "Обсидиан",
            DARK_STONE: "Тём.Камень", RED_STONE: "Крас.Камень",
            CRYSTALLITE_ORE: "Кристаллит", TENEBRITE_ORE: "Тенерит",
            GOLD_ORE: "Золото", PLATINUM_ORE: "Платина",
            MAGMATITE_ORE: "Магматит", ENCHANTED_QUARTZ: "Зач.Кварц",
        }
        item_name = names.get(block_type, "Блок")
        if item_name not in self.player.discovered_items and item_name not in (
                "Земля", "Камень", "Дерево", "Лестница", "Тём.Камень", "Крас.Камень"):
            self.show_discovery(f"Найдено: {item_name}!", (255, 200, 50))
            self.player.discovered_items.add(item_name)
        self.dropped_items_list.append(
            DroppedItem(col * TILE_SIZE + 12, row * TILE_SIZE + 12, item_name, block_type))
        self.world.set_block(row, col, AIR)
        if (row, col) in self.block_durability:
            del self.block_durability[(row, col)]

    def apply_hit_block(self, row, col, max_hits, block_type):
        coord = (row, col)
        if coord not in self.block_durability:
            self.block_durability[coord] = max_hits - 1
        else:
            self.block_durability[coord] -= 1
        if self.block_durability[coord] <= 0:
            self.spawn_dropped_item(row, col, block_type)
            world_x = col * TILE_SIZE + TILE_SIZE // 2
            world_y = row * TILE_SIZE + TILE_SIZE // 2
            self.spawn_particles(world_x, world_y, block_type)
            del self.block_durability[coord]
        # инвалидируем чанк, чтобы трещины отобразились на чанке
        chunk_x = col // CHUNK_SIZE
        self.world.chunk_surfaces.pop(chunk_x, None)

    def get_sky_color(self):
        progress = self.day_time / self.day_duration
        if progress < 0.35:
            return (135, 206, 235)
        elif progress < 0.50:
            f = (progress - 0.35) / 0.15
            return (int(135 + (30 - 135) * f),
                    int(206 + (30 - 206) * f),
                    int(235 + (60 - 235) * f))
        elif progress < 0.85:
            return (20, 25, 45)
        else:
            f = (progress - 0.85) / 0.15
            return (int(20 + (135 - 20) * f),
                    int(25 + (206 - 25) * f),
                    int(45 + (235 - 45) * f))

    # --- ГЛАВНЫЙ ЦИКЛ ---
    def run(self):
        global SCREEN_WIDTH, SCREEN_HEIGHT
        running = True
        while running:
            w, h = screen.get_size()
            if w != SCREEN_WIDTH or h != SCREEN_HEIGHT:
                SCREEN_WIDTH, SCREEN_HEIGHT = w, h
                _DARK_OVERLAY_CACHE.clear()
                global _TORCH_GLOW_SURFACE
                _TORCH_GLOW_SURFACE = None
                self.init_ui()
            running = self.handle_input()
            self.update()
            self.draw()
            clock.tick(FPS)
            self._fps_counter += 1
            self._fps_timer += clock.get_time()
            if self._fps_timer >= 500:
                self.fps_display = int(self._fps_counter / (self._fps_timer / 1000.0))
                self._fps_counter = 0
                self._fps_timer = 0
        pygame.quit()
        sys.exit()

    def handle_input(self):
        current_time = pygame.time.get_ticks()
        keys = pygame.key.get_pressed()
        jump_held = keys[pygame.K_SPACE] or keys[pygame.K_w] or keys[pygame.K_UP]
        down_held = keys[pygame.K_s] or keys[pygame.K_DOWN]
        sprint_held = keys[pygame.K_LSHIFT] or keys[pygame.K_RSHIFT]
        for tid, tpos in self.touches.items():
            if self.jump_btn.collidepoint(tpos):
                jump_held = True
            if self.down_btn.collidepoint(tpos):
                down_held = True

        any_ui_open = self.show_inventory or self.show_crafting or self.show_admin

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            elif event.type == pygame.FINGERDOWN:
                self.is_mobile = True
                tx, ty = event.x * SCREEN_WIDTH, event.y * SCREEN_HEIGHT
                self.touches[event.finger_id] = (tx, ty)
                if self.inv_btn.collidepoint(tx, ty) and current_time - self.last_ui_click > 250:
                    self.show_inventory = not self.show_inventory
                    if self.show_inventory:
                        self.show_crafting = False
                        self.show_admin = False
                    self.inventory_scroll_offset = 0
                    self.dragged_item_index = None
                    self.last_ui_click = current_time
                elif self.craft_btn.collidepoint(tx, ty) and current_time - self.last_ui_click > 250:
                    self.show_crafting = not self.show_crafting
                    if self.show_crafting:
                        self.show_inventory = False
                        self.show_admin = False
                    self.last_ui_click = current_time
                elif self.admin_btn.collidepoint(tx, ty) and current_time - self.last_ui_click > 250:
                    self.show_admin = not self.show_admin
                    if self.show_admin:
                        self.show_inventory = False
                        self.show_crafting = False
                    self.last_ui_click = current_time
                elif self.jump_btn.collidepoint(tx, ty):
                    self.player.jump()
                elif self.down_btn.collidepoint(tx, ty):
                    self.down_held = True
                elif self.show_inventory:
                    self.check_inventory_clicks(tx, ty)
                elif self.show_crafting:
                    self.check_crafting_clicks(tx, ty)
                elif self.show_admin:
                    self.check_admin_clicks(tx, ty)
                elif not any_ui_open:
                    for i, hr in enumerate(self.hotbar_rects):
                        if hr.collidepoint(tx, ty):
                            self.player.active_hotbar_index = i
                            break
                    else:
                        dist = math.hypot(tx - self.joy_center[0], ty - self.joy_center[1])
                        if dist < self.joy_radius + 20:
                            self.joy_active = event.finger_id
                        elif not self.jump_btn.collidepoint(tx, ty) and not self.down_btn.collidepoint(tx, ty):
                            if not self.try_place_block(tx, ty):
                                self.dig_block(tx, ty)
            elif event.type == pygame.FINGERMOTION:
                self.touches[event.finger_id] = (event.x * SCREEN_WIDTH, event.y * SCREEN_HEIGHT)
            elif event.type == pygame.FINGERUP:
                if event.finger_id in self.touches:
                    del self.touches[event.finger_id]
                if self.joy_active == event.finger_id:
                    self.joy_active = None
                    self.joy_x = 0.0
                    self.joy_y = 0.0
            elif event.type == pygame.MOUSEBUTTONDOWN and not self.is_mobile:
                if event.button == 1:
                    mx, my = event.pos
                    if self.inv_btn.collidepoint(mx, my):
                        self.show_inventory = not self.show_inventory
                        if self.show_inventory:
                            self.show_crafting = False
                            self.show_admin = False
                        self.inventory_scroll_offset = 0
                        self.dragged_item_index = None
                    elif self.craft_btn.collidepoint(mx, my):
                        self.show_crafting = not self.show_crafting
                        if self.show_crafting:
                            self.show_inventory = False
                            self.show_admin = False
                    elif self.admin_btn.collidepoint(mx, my):
                        self.show_admin = not self.show_admin
                        if self.show_admin:
                            self.show_inventory = False
                            self.show_crafting = False
                    elif self.jump_btn.collidepoint(mx, my):
                        self.player.jump()
                    elif self.down_btn.collidepoint(mx, my):
                        self.down_held = True
                    elif self.show_inventory:
                        self.check_inventory_clicks(mx, my)
                    elif self.show_crafting:
                        self.check_crafting_clicks(mx, my)
                    elif self.show_admin:
                        self.check_admin_clicks(mx, my)
                    elif not any_ui_open:
                        for i, hr in enumerate(self.hotbar_rects):
                            if hr.collidepoint(mx, my):
                                self.player.active_hotbar_index = i
                                break
                        else:
                            dist = math.hypot(mx - self.joy_center[0], my - self.joy_center[1])
                            if dist > self.joy_radius + 20:
                                if not self.try_place_block(mx, my):
                                    self.dig_block(mx, my)
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_e:
                    self.show_inventory = not self.show_inventory
                    if self.show_inventory:
                        self.show_crafting = False
                elif event.key == pygame.K_1:
                    self.player.active_hotbar_index = 0
                elif event.key == pygame.K_2:
                    self.player.active_hotbar_index = 1
                elif event.key == pygame.K_3:
                    self.player.active_hotbar_index = 2
                elif event.key in (pygame.K_SPACE, pygame.K_w, pygame.K_UP):
                    self.player.jump()

        if self.joy_active is not None and self.joy_active in self.touches:
            tx, ty = self.touches[self.joy_active]
            dx = tx - self.joy_center[0]
            dy = ty - self.joy_center[1]
            self.joy_x = max(-1.0, min(1.0, dx / self.joy_radius))
            self.joy_y = max(-1.0, min(1.0, dy / self.joy_radius))
        else:
            self.joy_x = 0.0
            self.joy_y = 0.0
            self.joy_active = None

        self.player.target_vx = 0
        if self.joy_x > 0.3 or keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.player.target_vx = WALK_SPEED
        elif self.joy_x < -0.3 or keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.player.target_vx = -WALK_SPEED
        if self.joy_y > 0.4:
            down_held = True
        self.jump_held = jump_held
        self.down_held = down_held
        self.sprint_held = sprint_held
        return True

    def update(self):
        self.day_time = (self.day_time + 1) % self.day_duration
        if self.player.dig_anim_time > 0:
            self.player.dig_anim_time -= 0.15
            if self.player.dig_anim_time < 0:
                self.player.dig_anim_time = 0.0
        self.player.update(self.world, self.jump_held, self.down_held, self.sprint_held)
        player_c = self.player.rect.center
        for item in self.dropped_items_list[:]:
            item.update(player_c, self.player.has_magnet, self.world)
            if self.player.rect.colliderect(item.rect):
                if self.player.add_item(item.name):
                    self.dropped_items_list.remove(item)
        for p in self.particles[:]:
            if not p.update():
                self.particles.remove(p)
        for m in self.messages[:]:
            if not m.update():
                self.messages.remove(m)
        self.camera_x = self.player.rect.centerx - SCREEN_WIDTH // 2
        self.camera_y = self.player.rect.centery - SCREEN_HEIGHT // 2
        self.camera_y = max(0, min(self.camera_y, WORLD_HEIGHT * TILE_SIZE - SCREEN_HEIGHT))

    def draw(self):
        sky_color = self.get_sky_color()
        screen.fill(sky_color)
        progress = self.day_time / self.day_duration
        if 0.50 < progress < 0.85:
            random.seed(42)
            for _ in range(40):
                sx = random.randint(0, SCREEN_WIDTH)
                sy = random.randint(0, int(SCREEN_HEIGHT * 0.4))
                pygame.draw.circle(screen, (255, 255, 255), (sx, sy), 1)
            random.seed()

        # Определяем видимые чанки и строки
        start_chunk = int(self.camera_x // (CHUNK_SIZE * TILE_SIZE)) - 1
        end_chunk = int((self.camera_x + SCREEN_WIDTH) // (CHUNK_SIZE * TILE_SIZE)) + 1
        visible_row_start = max(0, int(self.camera_y // TILE_SIZE) - 1)
        visible_row_end = min(WORLD_HEIGHT, int((self.camera_y + SCREEN_HEIGHT) // TILE_SIZE) + 2)

        for cx in range(start_chunk, end_chunk + 1):
            chunk_surf, y_src, h_src = self.world.get_chunk_surface_slice(
                cx, visible_row_start, visible_row_end)
            screen_x = cx * CHUNK_SIZE * TILE_SIZE - int(self.camera_x)
            screen_y = visible_row_start * TILE_SIZE - int(self.camera_y)
            src_rect = pygame.Rect(0, y_src, CHUNK_SIZE * TILE_SIZE, h_src)
            screen.blit(chunk_surf, (screen_x, screen_y), src_rect)

        # Поверх чанков рисуем блоки с трещинами (прочностью)
        for (r, c) in self.block_durability:
            block = self.world.get_block(r, c)
            if block != AIR:
                sx = c * TILE_SIZE - self.camera_x
                sy = r * TILE_SIZE - self.camera_y
                cracked = get_cracked_texture(block)
                if cracked:
                    screen.blit(cracked, (sx, sy))

        # Ореолы факелов
        glow_surf = get_torch_glow()
        for (tr, tc) in self.world.torch_positions:
            if start_chunk - 3 <= tc // CHUNK_SIZE <= end_chunk + 3 and 0 <= tr < WORLD_HEIGHT:
                sx = tc * TILE_SIZE - self.camera_x
                sy = tr * TILE_SIZE - self.camera_y
                screen.blit(glow_surf, (sx - _TORCH_GLOW_RADIUS, sy - _TORCH_GLOW_RADIUS),
                            special_flags=pygame.BLEND_ADD)

        # Темный оверлей
        player_y_world = self.player.rect.centery
        depth_factor = max(0, min(1, 1 - player_y_world / (WORLD_HEIGHT * TILE_SIZE)))
        is_night = 0.50 < progress < 0.85
        ambient_light = max(0.4, depth_factor) if not is_night else max(0.2, depth_factor * 0.6)
        global_dark_alpha = int((1 - ambient_light) * 180)
        if global_dark_alpha > 0:
            dark = _get_dark_overlay(global_dark_alpha, SCREEN_WIDTH, SCREEN_HEIGHT)
            screen.blit(dark, (0, 0))

        for item in self.dropped_items_list:
            ix = item.x - self.camera_x
            iy = item.y - self.camera_y
            if -20 <= ix < SCREEN_WIDTH + 20 and -20 <= iy < SCREEN_HEIGHT + 20:
                scaled = get_scaled_texture(item.block_type, 16)
                if scaled:
                    screen.blit(scaled, (ix, iy))

        p_sprite = self.player.get_current_sprite()
        screen.blit(p_sprite, (self.player.rect.x - self.camera_x,
                                self.player.rect.y - self.camera_y))

        for p in self.particles:
            p.draw(screen, self.camera_x, self.camera_y)

        # Джойстик
        pygame.draw.circle(screen, (80, 80, 80), self.joy_center, self.joy_radius, 4)
        kx = self.joy_center[0] + self.joy_x * self.joy_radius
        ky = self.joy_center[1] + self.joy_y * self.joy_radius
        pygame.draw.circle(screen, (220, 80, 80), (int(kx), int(ky)), 25)

        # Кнопка прыжка
        pygame.draw.circle(screen, (80, 80, 80), self.jump_btn.center, 40, 4)
        tj = font_large.render("Прыжок", True, (255, 255, 255))
        screen.blit(tj, (self.jump_btn.centerx - tj.get_width() // 2,
                         self.jump_btn.centery - tj.get_height() // 2))

        # Кнопка "вниз" (для лестниц)
        if self.player.check_ladder(self.world):
            pygame.draw.rect(screen, (60, 60, 80), self.down_btn)
            pygame.draw.rect(screen, (150, 150, 200), self.down_btn, 3)
            td = font_large.render("Вниз", True, (255, 255, 255))
            screen.blit(td, (self.down_btn.centerx - td.get_width() // 2,
                             self.down_btn.centery - td.get_height() // 2))

        for btn, txt, border in [(self.inv_btn, "Рюкзак", (200, 200, 200)),
                                  (self.craft_btn, "Крафт", (200, 200, 200)),
                                  (self.admin_btn, "Админка", (250, 100, 100))]:
            pygame.draw.rect(screen, (60, 60, 60), btn)
            pygame.draw.rect(screen, border, btn, 2)
            tr = font_large.render(txt, True, (255, 255, 255))
            screen.blit(tr, (btn.centerx - tr.get_width() // 2,
                             btn.centery - tr.get_height() // 2))

        screen.blit(font_large.render(f"Монеты: {self.player.coins}", True, (255, 215, 0)), (20, 20))
        time_txt = "Ночь" if (0.50 < progress < 0.85) else "День"
        screen.blit(font_large.render(f"Время: {time_txt}", True, (255, 255, 255)), (20, 42))
        cx = self.player.rect.x // TILE_SIZE
        cy = self.player.rect.y // TILE_SIZE
        screen.blit(font_large.render(f"X:{cx} Y:{cy}", True, (240, 240, 240)), (20, 64))
        fps_color = (100, 255, 100) if self.fps_display >= 45 else (
            (255, 200, 50) if self.fps_display >= 25 else (255, 80, 80))
        screen.blit(font_large.render(f"FPS: {self.fps_display}", True, fps_color), (20, 86))
        acc_text = []
        if self.player.has_amulet:
            acc_text.append("Амулет")
        if self.player.has_magnet:
            acc_text.append("Магнит")
        if self.player.has_speed_boots:
            acc_text.append("Сапоги")
        if self.player.has_miner_helmet:
            acc_text.append("Каска")
        if self.player.has_tough_belt:
            acc_text.append("Пояс")
        if acc_text:
            screen.blit(font_hud.render(f"Акс: {', '.join(acc_text)}", True, (200, 150, 255)), (20, 106))

        for i, msg in enumerate(self.messages):
            alpha = min(255, msg.timer * 4)
            s = font_msg.render(msg.text, True, msg.color)
            surf = pygame.Surface((s.get_width() + 20, s.get_height() + 10), pygame.SRCALPHA)
            surf.fill((0, 0, 0, min(180, alpha)))
            surf.blit(s, (10, 5))
            screen.blit(surf, (SCREEN_WIDTH // 2 - surf.get_width() // 2,
                               80 + i * 30 - int(msg.y_offset)))

        if not self.show_inventory:
            for i in range(3):
                hr = self.hotbar_rects[i]
                if i == self.player.active_hotbar_index:
                    pygame.draw.rect(screen, (46, 204, 113), hr, 4)
                    pygame.draw.rect(screen, (50, 80, 60), hr.inflate(-8, -8))
                else:
                    pygame.draw.rect(screen, (100, 100, 100), hr, 2)
                    pygame.draw.rect(screen, (40, 40, 40), hr.inflate(-4, -4))
                slot = self.player.hotbar[i]
                if slot["item"]:
                    screen.blit(font_small.render(slot["item"][:11], True, (255, 255, 255)),
                                (hr.x + 4, hr.y + 6))
                    if "Кирка" in slot["item"]:
                        pygame.draw.line(screen, (130, 90, 60),
                                         (hr.x + 18, hr.y + 52), (hr.x + 48, hr.y + 22), 4)
                    else:
                        bm = {
                            "Земля": DIRT, "Камень": STONE, "Дерево": WOOD, "Уголь": COAL,
                            "Железо": IRON_ORE, "Алмаз": DIAMOND_ORE, "Аметист": AMETHYST_ORE,
                            "Изумруд": EMERALD_ORE, "Рубин": RUBY_ORE, "Лестница": LADDER,
                            "Медь": COPPER_ORE, "Серебро": SILVER_ORE, "Топаз": TOPAZ_ORE,
                            "Сапфир": SAPPHIRE_ORE, "Обсидиан": OBSIDIAN_ORE, "Факел": TORCH,
                            "Тём.Камень": DARK_STONE, "Крас.Камень": RED_STONE,
                            "Кристаллит": CRYSTALLITE_ORE, "Тенерит": TENEBRITE_ORE,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
                        }
                        if slot["item"] in bm:
                            screen.blit(get_scaled_texture(bm[slot["item"]], 32),
                                        (hr.x + 20, hr.y + 22))
                    if slot["count"] > 1:
                        tc = font_small.render(str(slot["count"]), True, (255, 240, 100))
                        screen.blit(tc, (hr.right - tc.get_width() - 8, hr.bottom - 22))
                nl = font_small.render(str(i + 1), True, (180, 180, 180))
                screen.blit(nl, (hr.x + 6, hr.bottom - 16))

        # --- ОКНО ИНВЕНТАРЯ ---
        if self.show_inventory:
            pw, ph = 420, 540
            px = (SCREEN_WIDTH - pw) // 2
            py = (SCREEN_HEIGHT - ph) // 2
            pygame.draw.rect(screen, (40, 40, 40), (px, py, pw, ph))
            pygame.draw.rect(screen, (200, 180, 120), (px, py, pw, ph), 4)
            t = font_large.render("РЮКЗАК (Drag & Drop для переноса)", True, (200, 180, 120))
            screen.blit(t, (px + (pw - t.get_width()) // 2, py + 8))
            cell, gap = 65, 10
            gsx, gsy = px + 20, py + 45
            max_rows = 4
            start_idx = self.inventory_scroll_offset * 16
            end_idx = min(self.player.max_slots, start_idx + 16)
            for i in range(start_idx, end_idx):
                li = i - start_idx
                row, col = li // 4, li % 4
                cx = gsx + col * (cell + gap)
                cy = gsy + row * (cell + gap)
                if row >= max_rows:
