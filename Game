        self.hotbar = [
            {"item": "Дер. Кирка", "count": 1},
            {"item": "Лестница", "count": 10},
            {"item": None, "count": 0}
        ]
        self.active_hotbar_index = 0

    def add_item(self, item_name):
        is_tool = "Кирка" in item_name
        if not is_tool:
            for slot in self.hotbar:
                if slot["item"] == item_name:
                    slot["count"] += 1
                    return True
            for slot in self.inventory:
                if slot["item"] == item_name:
                    slot["count"] += 1
                    return True
        for slot in self.hotbar:
            if slot["item"] is None:
                slot["item"] = item_name
                slot["count"] = 1
                return True
        for slot in self.inventory:
            if slot["item"] is None:
                slot["item"] = item_name
                slot["count"] = 1
                return True
        return False

    def get_current_tool(self):
        return self.hotbar[self.active_hotbar_index]["item"]

    def get_pickaxe_count(self):
        count = 0
        for slot in self.inventory + self.hotbar:
            if slot["item"] and "Кирка" in slot["item"]:
                count += slot["count"]
        return count

    def get_current_sprite(self, _animations_unused=None):
        """Быстро: возвращает один из 4 заранее готовых базовых спрайтов."""
        walk_phase = (int(self.walk_frame) // 4) % 2 if self.is_walking else 0
        return _PLAYER_BASE_SPRITES.get((self.facing_right, walk_phase),
                                        _PLAYER_BASE_SPRITES[(True, 0)])

    _final_sprite_cache = {}  # оставляем для совместимости, не используется

    def update(self, world, jump_held=False, down_held=False, sprint_held=False):
        on_ladder = self.check_ladder(world)
        if on_ladder:
            self.is_climbing = True
            if jump_held:
                self.vy = JUMP_FORCE
                self.is_climbing = False
                self.is_grounded = False
            else:
                climb_speed = CLIMB_SPRINT if sprint_held else CLIMB_SPEED
                if down_held:
                    self.vy = climb_speed
                elif not jump_held:
                    self.vy = 0
                else:
                    self.vy = -climb_speed
        else:
            self.is_climbing = False
            self.vy += GRAVITY
            if self.vy > 15:
                self.vy = 15

        speed_mult = 1.3 if self.has_speed_boots else 1.0
        speed = WALK_SPEED * SPRINT_MULT * speed_mult if sprint_held else WALK_SPEED * speed_mult
        if self.target_vx != 0:
            target = speed if self.target_vx > 0 else -speed
            self.vx += (target - self.vx) * 0.25
        else:
            self.vx += (0 - self.vx) * FRICTION
        if abs(self.vx) < 0.1:
            self.vx = 0
        self.is_walking = abs(self.vx) > 0.5 and (self.is_grounded or self.is_climbing)
        if self.is_walking:
            self.walk_frame += 1
        else:
            self.walk_frame = 0

        self.rect.x += self.vx
        self._resolve_collisions(world, 'x')
        self.rect.y += self.vy
        self.is_grounded = False
        self._resolve_collisions(world, 'y')
        if self.is_grounded:
            self.jump_count = 0
        if self.vx > 0.2:
            self.facing_right = True
        elif self.vx < -0.2:
            self.facing_right = False

    def check_ladder(self, world):
        px_g = self.rect.centerx // TILE_SIZE
        py_g = self.rect.centery // TILE_SIZE
        for r in range(max(0, py_g - 1), min(WORLD_HEIGHT, py_g + 2)):
            for c in range(px_g - 1, px_g + 2):
                if world.get_block(r, c) == LADDER:
                    if self.rect.colliderect(pygame.Rect(c * TILE_SIZE, r * TILE_SIZE, TILE_SIZE, TILE_SIZE)):
                        return True
        return False

    def _resolve_collisions(self, world, direction):
        px_g = self.rect.centerx // TILE_SIZE
        py_g = self.rect.centery // TILE_SIZE
        for r in range(max(0, py_g - 2), min(WORLD_HEIGHT, py_g + 3)):
            for c in range(px_g - 2, px_g + 3):
                block = world.get_block(r, c)
                if block not in (AIR, LEAVES, LADDER, TORCH):
                    br = pygame.Rect(c * TILE_SIZE, r * TILE_SIZE, TILE_SIZE, TILE_SIZE)
                    if self.rect.colliderect(br):
                        if direction == 'x':
                            if self.vx > 0:
                                self.rect.right = br.left
                            elif self.vx < 0:
                                self.rect.left = br.right
                            self.vx = 0
                        else:
                            if self.vy > 0:
                                self.rect.bottom = br.top
                                self.vy = 0
                                self.is_grounded = True
                            elif self.vy < 0:
                                self.rect.top = br.bottom
                                self.vy = 0

    def jump(self):
        if self.is_climbing:
            self.vy = JUMP_FORCE
            self.is_climbing = False
            self.is_grounded = False
            return
        max_jumps = 2 if self.has_amulet else 1
        if self.is_grounded:
            self.vy = JUMP_FORCE
            self.is_grounded = False
            self.jump_count = 1
        elif self.jump_count < max_jumps:
            self.vy = JUMP_FORCE * 0.95
            self.jump_count += 1

