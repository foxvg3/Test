                            s_all = pygame.Rect(cx + cell // 2 + 1, cy + cell - 18, cell // 2 - 1, 18)
                            pygame.draw.rect(screen, (180, 80, 80), s1)
                            pygame.draw.rect(screen, (140, 50, 50), s_all)
                            t1 = font_small.render("1", True, (255, 255, 255))
                            ta = font_small.render("Всё", True, (255, 255, 255))
                            screen.blit(t1, (s1.centerx - t1.get_width() // 2,
                                             s1.centery - t1.get_height() // 2 + 1))
                            screen.blit(ta, (s_all.centerx - ta.get_width() // 2,
                                             s_all.centery - ta.get_height() // 2 + 1))
                else:
                    pygame.draw.rect(screen, (25, 25, 25), (cx, cy, cell, cell))
                    pygame.draw.rect(screen, (80, 50, 50), (cx, cy, cell, cell), 2)
                    tl = font_small.render("Блок", True, (150, 100, 100))
                    screen.blit(tl, (cx + (cell - tl.get_width()) // 2, cy + 22))

            hb_y = gsy + max_rows * (cell + gap) + 35
            hb_label = font_hud.render("Панель быстрого доступа:", True, (200, 180, 120))
            screen.blit(hb_label, (gsx, hb_y - 16))
            for idx in range(3):
                cx = gsx + idx * (cell + 15)
                cy = hb_y
                color = (90, 90, 50) if (self.dragged_item_index == idx and self.dragged_from_hotbar) else (50, 50, 70)
                pygame.draw.rect(screen, color, (cx, cy, cell, cell))
                pygame.draw.rect(screen, (100, 149, 237), (cx, cy, cell, cell), 2)
                slot = self.player.hotbar[idx]
                if slot["item"]:
                    screen.blit(font_small.render(slot["item"][:11], True, (255, 255, 255)),
                                (cx + 4, cy + 3))
                    if "Кирка" in slot["item"]:
                        pygame.draw.line(screen, (130, 90, 60),
                                         (cx + 18, cy + 48), (cx + 46, cy + 18), 4)
                    else:
                        bm = {
                            "Земля": DIRT, "Камень": STONE, "Дерево": WOOD,
                            "Уголь": COAL, "Железо": IRON_ORE, "Алмаз": DIAMOND_ORE,
                            "Аметист": AMETHYST_ORE, "Изумруд": EMERALD_ORE,
                            "Рубин": RUBY_ORE, "Лестница": LADDER, "Медь": COPPER_ORE,
                            "Серебро": SILVER_ORE, "Топаз": TOPAZ_ORE,
                            "Сапфир": SAPPHIRE_ORE, "Обсидиан": OBSIDIAN_ORE,
                            "Факел": TORCH, "Тём.Камень": DARK_STONE,
                            "Крас.Камень": RED_STONE, "Кристаллит": CRYSTALLITE_ORE,
                            "Тенерит": TENEBRITE_ORE,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
                        }
                        if slot["item"] in bm:
                            screen.blit(get_scaled_texture(bm[slot["item"]], 30),
                                        (cx + 17, cy + 15))
                    if slot["count"] > 1:
                        tc = font_small.render(str(slot["count"]), True, (255, 240, 100))
                        screen.blit(tc, (cx + cell - tc.get_width() - 6, cy + cell - 30))
                    is_tool = "Кирка" in slot["item"]
                    if not is_tool or self.player.get_pickaxe_count() >= 2:
                        s1 = pygame.Rect(cx, cy + cell - 18, cell // 2 - 2, 18)
                        s_all = pygame.Rect(cx + cell // 2 + 1, cy + cell - 18, cell // 2 - 1, 18)
                        pygame.draw.rect(screen, (180, 80, 80), s1)
                        pygame.draw.rect(screen, (140, 50, 50), s_all)
                        t1 = font_small.render("1", True, (255, 255, 255))
                        ta = font_small.render("Всё", True, (255, 255, 255))
                        screen.blit(t1, (s1.centerx - t1.get_width() // 2,
                                         s1.centery - t1.get_height() // 2 + 1))
                        screen.blit(ta, (s_all.centerx - ta.get_width() // 2,
                                         s_all.centery - ta.get_height() // 2 + 1))

            cost = self.get_slot_cost()
            bbr = pygame.Rect(px + 20, py + ph - 50, 300, 32)
            pygame.draw.rect(screen, (70, 130, 70), bbr)
            pygame.draw.rect(screen, (220, 255, 220), bbr, 2)
            tb = font_large.render(f"Новый слот: {cost} монет", True, (255, 255, 255))
            screen.blit(tb, (bbr.centerx - tb.get_width() // 2, bbr.centery - tb.get_height() // 2))

            su = pygame.Rect(px + pw - 45, py + 45, 30, 35)
            sd = pygame.Rect(px + pw - 45, py + 90, 30, 35)
            pygame.draw.rect(screen, (80, 80, 80), su)
            pygame.draw.rect(screen, (150, 150, 150), su, 1)
            pygame.draw.rect(screen, (80, 80, 80), sd)
            pygame.draw.rect(screen, (150, 150, 150), sd, 1)
            tu = font_hud.render("^", True, (255, 255, 255))
            td = font_hud.render("v", True, (255, 255, 255))
            screen.blit(tu, (su.centerx - tu.get_width() // 2, su.centery - tu.get_height() // 2))
            screen.blit(td, (sd.centerx - td.get_width() // 2, sd.centery - td.get_height() // 2))
            if self.dragged_item_index is not None:
                mx, my = pygame.mouse.get_pos()
                pygame.draw.rect(screen, (255, 255, 0), (mx - 15, my - 15, 30, 30), 2)

        # --- ОКНО КРАФТА ---
        if self.show_crafting:
            pw, ph = 380, 400
            px = (SCREEN_WIDTH - pw) // 2
            py = (SCREEN_HEIGHT - ph) // 2
            pygame.draw.rect(screen, (40, 40, 40), (px, py, pw, ph))
            pygame.draw.rect(screen, (100, 180, 200), (px, py, pw, ph), 4)
            t = font_large.render("РЕЦЕПТЫ КРАФТА", True, (100, 180, 200))
            screen.blit(t, (px + (pw - t.get_width()) // 2, py + 10))
            stations = f"Верстак: {'Есть' if self.player.has_crafting_table else 'Нет'} | Печка: {'Есть' if self.player.has_furnace else 'Нет'}"
            screen.blit(font_hud.render(stations, True, (255, 215, 0)), (px + 15, py + 30))
            acc = []
            if self.player.has_amulet:
                acc.append("Амулет")
            if self.player.has_magnet:
                acc.append("Магнит")
            if acc:
                screen.blit(font_hud.render(f"Аксессуары: {', '.join(acc)}", True, (200, 150, 255)),
                            (px + 15, py + 46))
            recipe_start_y = py + 64
            recipes = self.get_available_recipes()
            if not recipes:
                et = font_hud.render("Добудьте Дерево для начала!", True, (200, 200, 200))
                screen.blit(et, (px + (pw - et.get_width()) // 2, py + 100))
            for idx, recipe in enumerate(recipes):
                iy = recipe_start_y + idx * 34
                if iy + 30 > py + ph - 8:
                    break
                pygame.draw.rect(screen, (55, 55, 55), (px + 12, iy, pw - 24, 30))
                screen.blit(font_hud.render(recipe["name"], True, (255, 255, 255)),
                            (px + 16, iy + 2))
                screen.blit(font_small.render(recipe["req"], True, (200, 200, 200)),
                            (px + 16, iy + 17))
                has_all = True
                for ri, rc in recipe["items"].items():
                    total = sum(s["count"] for s in self.player.inventory + self.player.hotbar
                                if s["item"] == ri)
                    if total < rc:
                        has_all = False
                        break
                if has_all:
                    cb = pygame.Rect(px + pw - 95, iy + 2, 80, 26)
                    pygame.draw.rect(screen, (70, 140, 70), cb)
                    ct = font_small.render("Создать", True, (255, 255, 255))
                    screen.blit(ct, (cb.centerx - ct.get_width() // 2,
                                     cb.centery - ct.get_height() // 2))

        # --- АДМИН-ПАНЕЛЬ ---
        if self.show_admin:
            pw, ph = 560, 520
            px = (SCREEN_WIDTH - pw) // 2
            py = (SCREEN_HEIGHT - ph) // 2
            pygame.draw.rect(screen, (30, 20, 20), (px, py, pw, ph))
            pygame.draw.rect(screen, (250, 100, 100), (px, py, pw, ph), 4)
            t = font_large.render("АДМИН-ПАНЕЛЬ", True, (250, 100, 100))
            screen.blit(t, (px + (pw - t.get_width()) // 2, py + 8))

            # Монеты
            cb = pygame.Rect(px + 15, py + 30, 150, 28)
            pygame.draw.rect(screen, (180, 140, 40), cb)
            ct = font_small.render("+10000 монет", True, (255, 255, 255))
            screen.blit(ct, (cb.centerx - ct.get_width() // 2, cb.centery - ct.get_height() // 2))

            # Ресурсы
            screen.blit(font_hud.render("Ресурсы (+100):", True, (230, 230, 230)), (px + 15, py + 62))
            all_res = [
                "Земля", "Дерево", "Камень", "Тём.Камень", "Крас.Камень",
                "Доска", "Палка", "Уголь", "Медь", "Серебро",
                "Железо", "Жел. Слиток", "Золото", "Золот. Слиток", "Топаз",
                "Аметист", "Сапфир", "Алмаз", "Изумруд", "Кристаллит",
                "Тенерит", "Обсидиан", "Рубин", "Платина", "Магматит",
                "Зач.Кварц", "Лестница", "Факел",
            ]
            cols = 5
            col_w = (pw - 30) // cols
            for idx, res in enumerate(all_res):
                bx = px + 15 + (idx % cols) * col_w
                by = py + 78 + (idx // cols) * 26
                br = pygame.Rect(bx, by, col_w - 4, 22)
                pygame.draw.rect(screen, (55, 55, 80), br)
                rt = font_small.render(res[:10], True, (255, 255, 255))
                screen.blit(rt, (br.centerx - rt.get_width() // 2, br.centery - rt.get_height() // 2))

            # Кирки
            res_rows = math.ceil(len(all_res) / cols)
            pick_y = py + 78 + res_rows * 26 + 8
            screen.blit(font_hud.render("Кирки:", True, (230, 230, 230)), (px + 15, pick_y))
            pick_y += 16
            all_picks = sorted(PICKAXE_DATA.keys(), key=lambda k: PICKAXE_DATA[k]["tier"])
            pick_cols = 6
            pick_w = (pw - 30) // pick_cols
            for idx, pk in enumerate(all_picks):
                bx = px + 15 + (idx % pick_cols) * pick_w
                by = pick_y + (idx // pick_cols) * 30
                br = pygame.Rect(bx, by, pick_w - 4, 26)
                pygame.draw.rect(screen, (80, 55, 40), br)
                rt = font_small.render(pk[:10], True, (255, 255, 255))
                screen.blit(rt, (br.centerx - rt.get_width() // 2, br.centery - rt.get_height() // 2))

            # Станции и аксессуары
            pick_rows = math.ceil(len(all_picks) / pick_cols)
            acc_y = pick_y + pick_rows * 30 + 8
            screen.blit(font_hud.render("Станции и аксессуары:", True, (230, 230, 230)), (px + 15, acc_y))
            acc_y += 16
            acc_btns = [
                ("Верстак", (180, 140, 40)), ("Печка", (180, 100, 40)),
                ("Амулет", (160, 80, 200)), ("Магнит", (200, 50, 50)),
                ("Сапоги", (40, 160, 80)), ("Каска", (80, 140, 200)),
                ("Пояс", (160, 120, 50)),
            ]
            btn_w = (pw - 30) // 4
            for idx, (txt, col) in enumerate(acc_btns):
                bx = px + 15 + (idx % 4) * (btn_w + 4)
                by = acc_y + (idx // 4) * 32
                br = pygame.Rect(bx, by, btn_w, 28)
                pygame.draw.rect(screen, col, br)
                rt = font_small.render(txt, True, (255, 255, 255))
                screen.blit(rt, (br.centerx - rt.get_width() // 2, br.centery - rt.get_height() // 2))

        pygame.display.flip()


if __name__ == "__main__":
