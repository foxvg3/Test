_SCALED_TEXTURE_CACHE = {}

def get_scaled_texture(block_type, size):
    key = (block_type, size)
    if key not in _SCALED_TEXTURE_CACHE:
        tex = TEXTURES.get(block_type)
        if tex:
            _SCALED_TEXTURE_CACHE[key] = pygame.transform.scale(tex, (size, size)).convert_alpha()
        else:
            _SCALED_TEXTURE_CACHE[key] = None
    return _SCALED_TEXTURE_CACHE[key]

# --- ПРЕДВАРИТЕЛЬНО СОЗДАННЫЕ ПОВЕРХНОСТИ ДЛЯ ТЬМЫ ---
_DARK_OVERLAY_CACHE = {}

def _get_dark_overlay(dark_alpha, w, h):
    key = (dark_alpha, w, h)
    if key not in _DARK_OVERLAY_CACHE:
        surf = pygame.Surface((w, h), pygame.SRCALPHA)
        surf.fill((0, 0, 0, dark_alpha))
        _DARK_OVERLAY_CACHE[key] = surf
    return _DARK_OVERLAY_CACHE[key]

