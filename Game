class EndlessWorld:
    def __init__(self):
        self.chunks = {}
        self.chunk_surfaces = {}   # кэш отрисованных чанков
        self.torch_positions = set()
        for cx in range(-3, 4):
            self.generate_chunk(cx)

    def generate_chunk(self, cx):
        if cx in self.chunks:
            return
        # сохраняем состояние random для воспроизводимости
        old_random = random.getstate()
        random.seed(cx * 104729)
        chunk_data = [[AIR for _ in range(CHUNK_SIZE)] for _ in range(WORLD_HEIGHT)]
        heights = []
        h = 30
        for x in range(CHUNK_SIZE):
            if random.random() < 0.25:
                h += random.choice([-1, 1])
            h = max(15, min(h, 50))
            heights.append(h)
        for x in range(CHUNK_SIZE):
            curr_h = heights[x]
            for y in range(WORLD_HEIGHT):
                if y == curr_h:
                    chunk_data[y][x] = GRASS
                elif curr_h < y < curr_h + 6:
                    chunk_data[y][x] = DIRT
                elif y >= curr_h + 6:
                    rv = random.random()
                    if y >= 250:
                        if rv < 0.005:
                            chunk_data[y][x] = ENCHANTED_QUARTZ
                        elif rv < 0.012:
                            chunk_data[y][x] = MAGMATITE_ORE
                        elif rv < 0.018:
                            chunk_data[y][x] = PLATINUM_ORE
                        elif rv < 0.025:
                            chunk_data[y][x] = TENEBRITE_ORE
                        elif rv < 0.035:
                            chunk_data[y][x] = RUBY_ORE
                        elif rv < 0.050:
                            chunk_data[y][x] = OBSIDIAN_ORE
                        elif rv < 0.065:
                            chunk_data[y][x] = EMERALD_ORE
                        elif rv < 0.080:
                            chunk_data[y][x] = DIAMOND_ORE
                        elif rv < 0.50:
                            chunk_data[y][x] = RED_STONE
                        else:
                            chunk_data[y][x] = STONE
                    elif y >= 200:
                        if rv < 0.008:
                            chunk_data[y][x] = PLATINUM_ORE
                        elif rv < 0.018:
                            chunk_data[y][x] = MAGMATITE_ORE
                        elif rv < 0.030:
                            chunk_data[y][x] = TENEBRITE_ORE
                        elif rv < 0.045:
                            chunk_data[y][x] = RUBY_ORE
                        elif rv < 0.060:
                            chunk_data[y][x] = OBSIDIAN_ORE
                        elif rv < 0.075:
                            chunk_data[y][x] = CRYSTALLITE_ORE
                        elif rv < 0.095:
                            chunk_data[y][x] = EMERALD_ORE
                        elif rv < 0.12:
                            chunk_data[y][x] = DIAMOND_ORE
                        elif rv < 0.18:
                            chunk_data[y][x] = SAPPHIRE_ORE
                        elif rv < 0.45:
                            chunk_data[y][x] = DARK_STONE
                        else:
                            chunk_data[y][x] = STONE
                    elif y >= 140:
                        if rv < 0.015:
                            chunk_data[y][x] = CRYSTALLITE_ORE
                        elif rv < 0.03:
                            chunk_data[y][x] = OBSIDIAN_ORE
                        elif rv < 0.05:
                            chunk_data[y][x] = EMERALD_ORE
                        elif rv < 0.07:
                            chunk_data[y][x] = DIAMOND_ORE
                        elif rv < 0.10:
                            chunk_data[y][x] = SAPPHIRE_ORE
                        elif rv < 0.14:
                            chunk_data[y][x] = TOPAZ_ORE
                        elif rv < 0.40:
                            chunk_data[y][x] = DARK_STONE
                        else:
                            chunk_data[y][x] = STONE
                    elif y >= 100:
                        if rv < 0.025:
                            chunk_data[y][x] = GOLD_ORE
                        elif rv < 0.05:
                            chunk_data[y][x] = TOPAZ_ORE
                        elif rv < 0.07:
                            chunk_data[y][x] = AMETHYST_ORE
                        elif rv < 0.10:
                            chunk_data[y][x] = SILVER_ORE
                        elif rv < 0.12:
                            chunk_data[y][x] = IRON_ORE
                        elif rv < 0.14:
                            chunk_data[y][x] = COAL
                        elif rv < 0.50:
                            chunk_data[y][x] = DARK_STONE
                        else:
                            chunk_data[y][x] = STONE
                    elif y >= 75:
                        if rv < 0.03:
                            chunk_data[y][x] = SILVER_ORE
                        elif rv < 0.06:
                            chunk_data[y][x] = IRON_ORE
                        elif rv < 0.09:
                            chunk_data[y][x] = COAL
                        else:
                            chunk_data[y][x] = STONE
                    elif y >= 55:
                        if rv < 0.04:
                            chunk_data[y][x] = COPPER_ORE
                        elif rv < 0.07:
                            chunk_data[y][x] = COAL
                        else:
                            chunk_data[y][x] = STONE
                    else:
                        chunk_data[y][x] = STONE

        # Деревья
        for x in range(2, CHUNK_SIZE - 2):
            y_grass = heights[x]
            if random.random() < 0.12:
                if chunk_data[y_grass - 1][x - 1] == AIR and chunk_data[y_grass - 1][x + 1] == AIR:
                    th = random.randint(4, 6)
                    for tree_h in range(1, th + 1):
                        if y_grass - tree_h >= 0:
                            chunk_data[y_grass - tree_h][x] = WOOD
                    top_y = y_grass - th
                    for ly in range(top_y - 2, top_y + 1):
                        for lx in range(x - 2, x + 3):
                            if 0 <= ly < WORLD_HEIGHT and 0 <= lx < CHUNK_SIZE:
                                if chunk_data[ly][lx] == AIR:
                                    chunk_data[ly][lx] = LEAVES
                    if top_y - 3 >= 0:
                        chunk_data[top_y - 3][x] = LEAVES

        self.chunks[cx] = chunk_data
        random.setstate(old_random)

    def get_block(self, row, col):
        if row < 0 or row >= WORLD_HEIGHT:
            return AIR
        chunk_x = col // CHUNK_SIZE
        block_x = col % CHUNK_SIZE
        if chunk_x not in self.chunks:
            self.generate_chunk(chunk_x)
        return self.chunks[chunk_x][row][block_x]

    def set_block(self, row, col, block_type):
        if row < 0 or row >= WORLD_HEIGHT:
            return
        chunk_x = col // CHUNK_SIZE
        block_x = col % CHUNK_SIZE
        if chunk_x not in self.chunks:
            self.generate_chunk(chunk_x)
        old_block = self.chunks[chunk_x][row][block_x]
        if old_block == TORCH:
            self.torch_positions.discard((row, col))
        if block_type == TORCH:
            self.torch_positions.add((row, col))
        self.chunks[chunk_x][row][block_x] = block_type
        # инвалидируем кэш чанка
        self.chunk_surfaces.pop(chunk_x, None)

    def get_chunk_surface(self, cx):
        if cx in self.chunk_surfaces:
            return self.chunk_surfaces[cx]
        if cx not in self.chunks:
            self.generate_chunk(cx)
        chunk_data = self.chunks[cx]
        # Рендерим весь чанк один раз, но используем convert() для скорости
        surf = pygame.Surface((CHUNK_SIZE * TILE_SIZE, WORLD_HEIGHT * TILE_SIZE))
        surf.fill((20, 20, 40))  # фоновый цвет пещеры
        for y in range(WORLD_HEIGHT):
            for x in range(CHUNK_SIZE):
                block = chunk_data[y][x]
                if block != AIR:
                    tex = TEXTURES.get(block)
                    if tex:
                        surf.blit(tex, (x * TILE_SIZE, y * TILE_SIZE))
        surf = surf.convert()  # КЛЮЧЕВАЯ ОПТИМИЗАЦИЯ: конвертируем в формат дисплея
        self.chunk_surfaces[cx] = surf
        return surf

    def get_chunk_surface_slice(self, cx, row_start, row_end):
        """Получить только нужный вертикальный срез чанка для рендера."""
        full = self.get_chunk_surface(cx)
        y_start = row_start * TILE_SIZE
        height = (row_end - row_start) * TILE_SIZE
        return full, y_start, height

