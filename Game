class DiscoveryMessage:
    def __init__(self, text, color=(255, 220, 100)):
        self.text = text
        self.color = color
        self.timer = 120
        self.y_offset = 0

    def update(self):
        self.timer -= 1
        self.y_offset = max(0, (120 - self.timer) * 0.3) if self.timer < 30 else 0
        return self.timer > 0

# --- ВЫПАВШИЙ ПРЕДМЕТ ---
class DroppedItem:
    def __init__(self, x, y, name, block_type):
        self.x = x
        self.y = y
        self.name = name
        self.block_type = block_type
        self.vx = random.uniform(-1.5, 1.5)
        self.vy = random.uniform(-3, -1)
        self.rect = pygame.Rect(x, y, 14, 14)
        self.is_grounded = False

    def update(self, player_pos, has_magnet, world):
        if not self.is_grounded:
            self.vy += 0.25
            if self.vy > 8:
                self.vy = 8
        else:
            self.vy = 0
        self.x += self.vx
        self.y += self.vy
        self.rect.x = int(self.x)
        self.rect.y = int(self.y)
        if self.is_grounded:
            self.vx *= 0.8
        else:
            self.vx *= 0.98
        self._resolve_collisions(world)
        if has_magnet:
            dx = player_pos[0] - self.x
            dy = player_pos[1] - self.y
            dist = math.hypot(dx, dy)
            if dist < TILE_SIZE * 5:
                self.is_grounded = False
                speed = 5.0
                self.vx += (dx / dist) * speed * 0.15
                self.vy += (dy / dist) * speed * 0.15
                self.vx = max(-7, min(7, self.vx))
                self.vy = max(-7, min(7, self.vy))

    def _resolve_collisions(self, world):
        self.is_grounded = False
        px_grid = int(self.rect.centerx // TILE_SIZE)
        py_grid = int(self.rect.centery // TILE_SIZE)
        for r in range(max(0, py_grid - 1), min(WORLD_HEIGHT, py_grid + 2)):
            for c in range(px_grid - 1, px_grid + 2):
                block = world.get_block(r, c)
                if block not in (AIR, LEAVES, LADDER, TORCH):
                    br = pygame.Rect(c * TILE_SIZE, r * TILE_SIZE, TILE_SIZE, TILE_SIZE)
                    if self.rect.colliderect(br):
                        ox = min(self.rect.right, br.right) - max(self.rect.left, br.left)
                        oy = min(self.rect.bottom, br.bottom) - max(self.rect.top, br.top)
                        if ox < oy:
                            self.x += -ox if self.rect.centerx < br.centerx else ox
                            self.vx = 0
                        else:
                            if self.rect.centery < br.centery:
                                self.y -= oy
                                self.vy = 0
                                self.is_grounded = True
                            else:
                                self.y += oy
                                self.vy = 0
        # немедленно синхронизируем rect
        self.rect.x = int(self.x)
        self.rect.y = int(self.y)

