# Создаём 4 базовых спрайта один раз при запуске, потом только blitируем
_PLAYER_BASE_SPRITES = {}   # (facing_right, walk_phase 0/1) -> Surface

def _build_player_base(facing_right, walk_phase):
    """Строит простой пиксель-арт спрайт игрока. Вызывается 4 раза при старте."""
    W, H = 28, 44
    surf = pygame.Surface((W, H), pygame.SRCALPHA)
    bob = 1 if walk_phase else 0

    # Ноги
    lleg_y = 33 + (bob if walk_phase else 0)
    rleg_y = 33 + (0 if walk_phase else bob)
    pygame.draw.rect(surf, (50, 50, 75), (5, lleg_y, 8, 8))
    pygame.draw.rect(surf, (30, 20, 20), (5, lleg_y + 6, 8, 4))
    pygame.draw.rect(surf, (50, 50, 75), (15, rleg_y, 8, 8))
    pygame.draw.rect(surf, (30, 20, 20), (15, rleg_y + 6, 8, 4))

    # Тело
    pygame.draw.rect(surf, (40, 90, 180), (4, 18 - bob, 20, 15))
    pygame.draw.rect(surf, (25, 60, 130), (4, 18 - bob, 20, 5))   # воротник
    pygame.draw.rect(surf, (55, 35, 15), (4, 32, 20, 3))           # пояс

    # Рюкзак
    bp_x = 0 if facing_right else 23
    pygame.draw.rect(surf, (90, 55, 25), (bp_x, 18, 5, 14))
    pygame.draw.rect(surf, (70, 40, 15), (bp_x, 22, 5, 6))

    # Рука
    hand_x = 22 if facing_right else 0
    pygame.draw.rect(surf, (40, 90, 180), (hand_x, 20, 6, 5))
    pygame.draw.rect(surf, (240, 185, 130), (hand_x, 24, 6, 6))

    # Голова
    pygame.draw.rect(surf, (240, 185, 130), (6, 4 - bob, 16, 14))
    pygame.draw.rect(surf, (75, 45, 20), (5, 2 - bob, 18, 6))   # шляпа/волосы
    # Глаза
    eye_x = 17 if facing_right else 7
    pygame.draw.rect(surf, (255, 255, 255), (eye_x, 7 - bob, 4, 4))
    pygame.draw.rect(surf, (0, 0, 0), (eye_x + (1 if facing_right else 1), 8 - bob, 2, 2))
    # Нос
    pygame.draw.rect(surf, (210, 150, 100), (12, 11 - bob, 4, 3))

    surf = surf.convert_alpha()
    return surf

def init_player_sprites():
    for fr in (True, False):
        for wp in (0, 1):
            _PLAYER_BASE_SPRITES[(fr, wp)] = _build_player_base(fr, wp)

