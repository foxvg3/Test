_PARTICLE_SURFACES = {}

def _get_particle_surface(size, color):
    key = (size, color[0] // 10, color[1] // 10, color[2] // 10)
    if key not in _PARTICLE_SURFACES:
        s = pygame.Surface((size * 2, size * 2), pygame.SRCALPHA)
        pygame.draw.circle(s, color, (size, size), size)
        _PARTICLE_SURFACES[key] = s
    return _PARTICLE_SURFACES[key]

class Particle:
    def __init__(self, x, y, color):
        self.x = x
        self.y = y
        self.color = color
        self.vx = random.uniform(-3, 3)
        self.vy = random.uniform(-5, -1)
        self.life = random.randint(15, 35)
        self.max_life = self.life
        self.size = random.randint(2, 5)

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.vy += 0.15
        self.life -= 1
        return self.life > 0

    def draw(self, screen, cam_x, cam_y):
        alpha = int(255 * (self.life / self.max_life))
        sx = self.x - cam_x
        sy = self.y - cam_y
        if sx < -10 or sx > SCREEN_WIDTH + 10 or sy < -10 or sy > SCREEN_HEIGHT + 10:
            return
        s = _get_particle_surface(self.size, self.color)
        s.set_alpha(alpha)
        screen.blit(s, (sx - self.size, sy - self.size))

