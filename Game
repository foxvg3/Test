                if i < self.player.max_slots:
                    color = (90, 90, 50) if (self.dragged_item_index == i and not self.dragged_from_hotbar) else (60, 60, 60)
                    pygame.draw.rect(screen, color, (cx, cy, cell, cell))
                    pygame.draw.rect(screen, (120, 120, 120), (cx, cy, cell, cell), 2)
                    slot = self.player.inventory[i]
                    if slot["item"]:
                        screen.blit(font_small.render(slot["item"][:11], True, (255, 255, 255)),
