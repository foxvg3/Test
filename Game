                        if "Кирка" in slot["item"]:
                            pygame.draw.line(screen, (130, 90, 60),
                                             (cx + 18, cy + 48), (cx + 46, cy + 18), 4)
                        else:
                            bm = {
                                "Земля": DIRT, "Камень": STONE, "Дерево": WOOD,
                                "Уголь": COAL, "Железо": IRON_ORE, "Алмаз": DIAMOND_ORE,
                                "Аметист": AMETHYST_ORE, "Изумруд": EMERALD_ORE,
                                "Рубин": RUBY_ORE, "Лестница": LADDER, "Медь": COPPER_ORE,
                                "Серебро": SILVER_ORE, "Топаз": TOPAZ_ORE,
                                "Сапфир": SAPPHIRE_ORE, "Обсидиан": OBSIDIAN_ORE,
                                "Факел": TORCH, "Тём.Камень": DARK_STONE,
                                "Крас.Камень": RED_STONE, "Кристаллит": CRYSTALLITE_ORE,
                                "Тенерит": TENEBRITE_ORE,
                            "Золото": GOLD_ORE, "Платина": PLATINUM_ORE, "Магматит": MAGMATITE_ORE, "Зач.Кварц": ENCHANTED_QUARTZ,
                            }
                            if slot["item"] in bm:
                                screen.blit(get_scaled_texture(bm[slot["item"]], 30),
                                            (cx + 17, cy + 15))
                        if slot["count"] > 1:
                            tc = font_small.render(str(slot["count"]), True, (255, 240, 100))
                            screen.blit(tc, (cx + cell - tc.get_width() - 6, cy + cell - 30))
                        is_tool = "Кирка" in slot["item"]
