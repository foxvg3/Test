        if scroll_up_btn.collidepoint(px, py) and self.inventory_scroll_offset > 0:
            self.inventory_scroll_offset -= 1
            return
        if scroll_down_btn.collidepoint(px, py):
            max_off = max(0, math.ceil(self.player.max_slots / 16) - 1)
            if self.inventory_scroll_offset < max_off:
                self.inventory_scroll_offset += 1
            return

        cost = self.get_slot_cost()
        buy_btn_rect = pygame.Rect(panel_x + 20, panel_y + panel_h - 45, 300, 32)
        if buy_btn_rect.collidepoint(px, py) and self.player.coins >= cost:
            self.player.coins -= cost
            self.player.max_slots += 1
            self.player.inventory.append({"item": None, "count": 0})
            return

        cell_size = 65
        spacing = 10
        grid_start_x = panel_x + 20
        grid_start_y = panel_y + 45
        max_grid_h = 4 * (cell_size + spacing)
        start_idx = self.inventory_scroll_offset * 16
        end_idx = min(self.player.max_slots, start_idx + 16)

        for i in range(start_idx, end_idx):
            local_i = i - start_idx
            row, col = local_i // 4, local_i % 4
            cx = grid_start_x + col * (cell_size + spacing)
            cy = grid_start_y + row * (cell_size + spacing)
